<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Glassmorphism Panel Drawable: Deep translucent glass with 22dp corner radius -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#590D182E" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <padding
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp" />
</shape>
